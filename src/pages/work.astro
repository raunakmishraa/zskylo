---
import SiteLayout from "../layouts/SiteLayout.astro";
const projects = [
  { n: "01", name: "Skinociti", type: "Electronics e-commerce · United States", detail: "E-commerce website for a US electronics business.", url: "https://www.skinociti.com/" },
  { n: "02", name: "Rapti Fashion Direct", type: "E-commerce · United States", detail: "E-commerce platform developed in Laravel for a US client.", url: "https://raptifashiondirect.com/" },
  { n: "03", name: "Study Overseas", type: "Education consultancy · Nepal", detail: "Website for an education consultancy in Nepal.", url: "https://www.studyoverseas.edu.np/" },
  { n: "04", name: "Investment Guru 2.0", type: "Education · Nepal", detail: "Website for a share-market training institute, including course enrolment.", url: "https://www.investmentguru.com.np/" },
  { n: "05", name: "Investment Guru v1", type: "Previous website version", detail: "An earlier version of the Investment Guru website.", url: "https://ig-v1.raunakmishra.com.np/" },
  { n: "06", name: "Nexo Global", type: "International consultancy · Australia", detail: "International consultancy website for an Australian client.", url: "https://nexoglobal.netlify.app/" },
];
---
<SiteLayout title="Selected Work — Zskylo" description="Live website glimpses of selected software and e-commerce projects developed by Zskylo.">
  <section class="page-hero wrap">
    <p class="eyebrow"><span class="eyebrow-line"></span> Selected work / 06 projects</p>
    <h1>Different briefs.<br /><span class="text-blue">Purposeful builds.</span></h1>
    <p class="page-lede">Explore glimpses of the live websites behind selected projects across commerce, education and consultancy. Open any project to experience the full website.</p>
  </section>
  <section class="wrap live-portfolio-grid" aria-label="Selected software development projects" aria-describedby="portfolio-preview-note">
    {projects.map((project) => <article class="live-portfolio-card" aria-labelledby={`project-title-${project.n}`}>
      <a class="site-glimpse portfolio-glimpse" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.name} live website`}>
        <span class="glimpse-browser-bar"><span class="glimpse-browser-dots"><i></i><i></i><i></i></span><span>{project.name}</span><span class="glimpse-preview-type">Website preview</span><b aria-hidden="true">↗</b></span>
        {project.name === "Skinociti" ? <img class="skinociti-static-preview" src="https://image.thum.io/get/width/1200/crop/800/noanimate/https://www.skinociti.com/" alt="Static screenshot preview of the Skinociti website" loading="lazy" /> : <iframe src={project.url} title={`${project.name} live website preview`} loading="lazy" tabindex="-1" referrerpolicy="strict-origin-when-cross-origin"></iframe>}
        <span class="glimpse-open-label">Open live website <b aria-hidden="true">↗</b></span>
      </a>
      <div class="live-portfolio-info">
        <span class="eyebrow">{project.n} / {project.type}</span>
        <div class="live-portfolio-title"><div><h2 id={`project-title-${project.n}`}>{project.name}</h2><p>{project.detail}</p></div><a href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Visit ${project.name} website`}>↗</a></div>
      </div>
    </article>)}
  </section>
  <p class="wrap glimpse-note" id="portfolio-preview-note">Previews are loaded from the original websites. Some site owners restrict embedded viewing, so a preview may appear blank or incomplete. Use the project link to open the full website in a new tab.</p>
  <section class="section wrap service-end"><p class="eyebrow">Have a project to discuss?</p><h2>Let’s work on<br /><span class="text-blue">what’s next.</span></h2><a class="button" href="/contact/">Get in touch <span aria-hidden="true">↗</span></a></section>
</SiteLayout>
