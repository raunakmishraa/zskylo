---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Zskylo — Software Development & Brand Growth",
  description = "Software development, brand growth and independent digital products from Zskylo, Nepal."
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f5f0" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Zskylo" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Zskylo",
        "url": "https://zskylo.com/",
        "description": "Software development, brand growth and independent digital products from Zskylo, Nepal.",
        "email": "hello@zskylo.com",
        "telephone": "+977 9761165180",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Imadol, Lalitpur",
          "addressCountry": "NP"
        }
      }
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
    <script is:inline>
      (() => {
        try {
        const headings = document.querySelectorAll("main .page-hero h1");
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        headings.forEach((heading) => {
          const originalText = heading.textContent || "";
          heading.setAttribute("aria-label", originalText.replace(/\s+/g, " ").trim());

          if (reducedMotion) {
            heading.classList.add("is-ready");
            return;
          }

          const reservedHeight = heading.getBoundingClientRect().height;
          heading.style.minHeight = reservedHeight + "px";

          const walker = document.createTreeWalker(heading, NodeFilter.SHOW_TEXT);
          const textNodes = [];
          while (walker.nextNode()) {
            if (walker.currentNode.nodeValue) textNodes.push(walker.currentNode);
          }

          const segments = textNodes.map((node) => {
            const segment = document.createElement("span");
            segment.className = "typewriter-segment";
            segment.dataset.fullText = node.nodeValue || "";
            node.parentNode.replaceChild(segment, node);
            return segment;
          });

          let segmentIndex = 0;
          let characterIndex = 0;
          heading.classList.add("is-typing");

          const typeNext = () => {
            const segment = segments[segmentIndex];
            if (!segment) {
              heading.classList.remove("is-typing");
              heading.classList.add("is-ready");
              heading.style.minHeight = "";
              return;
            }

            const fullText = segment.dataset.fullText || "";
            if (characterIndex === 0) segment.classList.add("is-active");
            segment.textContent = fullText.slice(0, characterIndex + 1);
            characterIndex += 1;

            if (characterIndex < fullText.length) {
              window.setTimeout(typeNext, 34);
            } else {
              segment.classList.remove("is-active");
              segmentIndex += 1;
              characterIndex = 0;
              window.setTimeout(typeNext, 35);
            }
          };

          if (segments.length) typeNext();
          else {
            heading.classList.add("is-ready");
            heading.style.minHeight = "";
          }
        });
        } catch (error) {
          document.querySelectorAll(".typewriter-segment").forEach((segment) => {
            segment.textContent = segment.dataset.fullText || "";
            segment.classList.remove("is-active");
          });
          document.querySelectorAll("main .page-hero h1").forEach((heading) => {
            heading.classList.add("is-ready");
            heading.style.minHeight = "";
          });
          document.documentElement.classList.remove("js");
        }
      })();
    </script>
  </body>
</html>
