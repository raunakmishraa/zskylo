---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="About — Zskylo" description="Learn about Zskylo, a Nepal-based firm working across software development, brand growth and independent digital products.">
  <section class="page-hero wrap about-hero">
    <p class="eyebrow"><span class="eyebrow-line"></span> About Zskylo</p>
    <h1>Clear thinking.<br /><span class="text-blue">Useful outcomes.</span></h1>
    <p class="page-lede">Zskylo is a Nepal-based firm connecting apps, automating workflows, building custom business systems, shaping brand growth strategies and developing independent digital products.</p>
  </section>

  <section class="about-statement">
    <div class="wrap about-grid">
      <p class="eyebrow">How we approach the work</p>
      <div>
        <h2>Understand the need.<br />Respect the details.<br /><span class="text-blue">Deliver with care.</span></h2>
        <p>Every project has a purpose behind it. Our focus is to understand that purpose and shape the digital work around it — whether that means building a website, supporting a brand, or developing a product.</p>
      </div>
    </div>
  </section>

  <section class="wrap about-divisions">
    <div class="about-section-heading">
      <p class="eyebrow">One firm / Three areas</p>
      <h2>Different kinds of work.<br /><span class="text-blue">A shared standard.</span></h2>
    </div>
    <div class="about-division-grid">
      <article>
        <span class="about-division-number">01</span>
        <h3>Software Development</h3>
        <p>Websites, e-commerce platforms, CRM systems, integrations, workflow automation and custom business tools.</p>
        <a href="/services/#software">Explore software development <span aria-hidden="true">↗</span></a>
      </article>
      <article>
        <span class="about-division-number">02</span>
        <h3>Brand Growth</h3>
        <p>Brand content and marketing support, from video editing and ad scripting to social media and digital campaigns.</p>
        <a href="/services/#growth">Explore brand growth <span aria-hidden="true">↗</span></a>
      </article>
      <article>
        <span class="about-division-number">03</span>
        <h3>Our Products</h3>
        <p>Independent digital products, each developed around its own purpose, team and digital presence.</p>
        <a href="/products/">Explore our products <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </section>

  <section class="about-principle">
    <div class="wrap about-principle-inner">
      <p class="eyebrow">Our working principle</p>
      <h2>Clear Scope.<br /><span>Careful Engineering.</span><br />Useful Handover.</h2>
      <p>We value a shared understanding of the work, considered implementation and a handover that leaves the outcome useful beyond launch.</p>
    </div>
  </section>

  <section class="wrap about-details">
    <div><span class="eyebrow">Based in</span><h3>Imadol, Lalitpur</h3><p>Nepal</p></div>
    <div><span class="eyebrow">Email</span><h3><a href="mailto:hello@zskylo.com">hello@zskylo.com</a></h3></div>
    <div><span class="eyebrow">Phone</span><h3><a href="tel:+9779761165180">+977 9761165180</a></h3></div>
  </section>
  <section class="wrap about-contact-cta">
    <p class="eyebrow">Have something in mind?</p>
    <h2>Let’s make the next step<br /><span class="text-blue">clear.</span></h2>
    <a class="button" href="/contact/">Start a Project <span aria-hidden="true">↗</span></a>
  </section>
</SiteLayout>
