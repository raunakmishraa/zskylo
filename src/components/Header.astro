---
const links = [
  { href: "/", label: "Home" },
  { href: "/services/", label: "Services" },
  { href: "/work/", label: "Work" },
  { href: "/products/", label: "Products" },
  { href: "/about/", label: "About" },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="header-inner wrap">
    <a class="wordmark" href="/" aria-label="Zskylo home"><span class="wordmark-mark">Z</span><span>zskylo</span></a>
    <nav aria-label="Main navigation">
      {links.map((link) => <a class:list={["nav-link", { active: path === link.href }]} href={link.href}>{link.label}</a>)}
    </nav>
    <a class="button button-small header-cta" href="/contact/">Let’s talk <span aria-hidden="true">↗</span></a>
  </div>
</header>
