---
import SiteLayout from "../layouts/SiteLayout.astro";

const services = [
  {
    number: "01",
    id: "software",
    title: "Software Development",
    statement: "Build tools around the way your business works.",
    description: "From business websites and e-commerce platforms to CRM systems and integrations, we build digital tools around your requirements.",
    capabilities: ["Websites & web applications", "Custom business systems", "CRM & digital tools", "Workflow automation & integrations"],
    href: "/services/#software",
    link: "Explore software development",
    visual: "software-visual",
  },
  {
    number: "02",
    id: "growth",
    title: "Brand Growth",
    statement: "Plan, produce and deliver your brand content.",
    description: "We help businesses plan and produce content through social media marketing, digital campaigns, ad scripting, video editing and production.",
    capabilities: ["Social & digital marketing", "Video editing & production", "Ad scripting & creative direction", "Shooting & content delivery"],
    href: "/services/#growth",
    link: "Explore brand growth",
    visual: "growth-visual",
  },
];

const projects = [
  { number: "01", name: "Skinociti", type: "Electronics e-commerce", detail: "E-commerce website for a US electronics business.", url: "https://www.skinociti.com/" },
  { number: "02", name: "Rapti Fashion Direct", type: "E-commerce · Laravel", detail: "E-commerce platform developed for a US client.", url: "https://raptifashiondirect.com/" },
  { number: "03", name: "Study Overseas", type: "Education consultancy", detail: "Website for an education consultancy in Nepal.", url: "https://www.studyoverseas.edu.np/" },
  { number: "04", name: "Investment Guru 2.0", type: "Education & enrolment", detail: "Website for a share-market training institute, including course enrolment.", url: "https://www.investmentguru.com.np/" },
  { number: "05", name: "Investment Guru v1", type: "Previous website version", detail: "An earlier version of the Investment Guru website.", url: "https://ig-v1.raunakmishra.com.np/" },
  { number: "06", name: "Nexo Global", type: "International consultancy", detail: "Consultancy website for an Australian client.", url: "https://nexoglobal.netlify.app/" },
];

const products = [
  { name: "AashrayaCare", description: "Caregiver and care-home discovery platform.", url: "https://aashraya-care.netlify.app/", label: "Explore product" },
  { name: "Yittzy", description: "A town event-listing platform.", url: "", label: "Coming soon" },
  { name: "Cashify Wallet", description: "An independent fintech product.", url: "https://cashifywallet.com/", label: "Explore product" },
];

const faqs = [
  { q: "What does Zskylo do?", a: "Zskylo provides Software Development and Brand Growth services for businesses. We also build independent products that are managed separately from client work." },
  { q: "What kind of software projects do you take on?", a: "We build business websites, e-commerce platforms, web applications, CRM systems, integrations, workflow automations and custom business tools." },
  { q: "What is included in Brand Growth?", a: "Brand Growth can include social media and digital marketing, content strategy, ad scripting, shooting, video editing and content delivery." },
  { q: "How do I start a project?", a: "Share your requirements through the project enquiry form. We’ll review the brief and discuss the scope and next steps with you." },
  { q: "Is there a fee for the initial discussion?", a: "There is no initial consultation fee. We can first review your requirements and discuss the project before agreeing to any work." },
  { q: "How much does a project cost?", a: "Pricing depends on the deliverables, complexity and agreed scope. We’ll discuss it after understanding what the project involves." },
  { q: "How long will a project take?", a: "The timeline depends on the requirements and scope. We’ll discuss a realistic schedule after reviewing the brief." },
  { q: "Are AashrayaCare, Yittzy and Cashify Wallet client services?", a: "No. They are standalone products managed separately from client services, each with its own team and website." },
];
---
<SiteLayout title="Zskylo | Software Development & Brand Growth in Nepal" description="Zskylo helps businesses build custom software, connect applications, automate workflows and grow their brands through creative and digital marketing solutions.">
  <section class="home-hero">
    <div class="wrap home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> Software Development · Brand Growth · Nepal</p>
        <h1 class="hero-typewriter is-pending" aria-label="Build better systems. Grow stronger brands."><span class="typewriter-line" data-typewriter-line="Build better systems.">Build better systems.</span><span class="text-blue typewriter-line" data-typewriter-line="Grow stronger brands.">Grow stronger brands.</span></h1>
        <p class="home-hero-lede">We help businesses build websites and custom systems, connect their tools, automate workflows and develop their brand through content and digital marketing.</p>
        <a class="button home-primary-cta" href="/contact/">Start a Project <span aria-hidden="true">↗</span></a>
        <p class="hero-note" style="margin-bottom: 18px;">Share your requirements. We’ll discuss the scope and next steps.</p>
      </div>
      <div class="home-hero-art" role="img" aria-label="Abstract diagram showing connected business systems and creative channels">
        <div class="art-topline"><span>ZS / SYSTEMS + STORY</span><span>NEPAL · WORKING EVERYWHERE</span></div>
        <div class="art-grid-lines" aria-hidden="true"></div>
        <div class="art-center"><img class="art-center-logo" src="/logo.svg" alt="" width="88" height="88" /><span>ZS / BUILT<br/>TO CONNECT</span></div>
        <div class="art-node art-node-one"><span class="art-node-symbol">↗</span><b>CONNECT</b><small>Applications</small></div>
        <div class="art-node art-node-two"><span class="art-node-symbol">⌘</span><b>BUILD</b><small>Systems</small></div>
        <div class="art-node art-node-three"><span class="art-node-symbol">✳</span><b>GROW</b><small>Brands</small></div>
        <span class="art-orbit art-orbit-one" aria-hidden="true"></span>
        <span class="art-orbit art-orbit-two" aria-hidden="true"></span>
        <div class="art-bottomline"><span>01 — CLARITY</span><span>02 — EXECUTION</span><span>03 — HANDOVER</span></div>
      </div>
    </div>
    <div class="wrap hero-footnote"><span>IMADOL, LALITPUR, NEPAL</span><span>TECHNOLOGY × CREATIVE EXECUTION</span></div>
  </section>

  <section class="home-services section wrap" id="services">
    <div class="home-section-heading">
      <div><p class="eyebrow">What we do</p><h2>Software for how you work.<br/><span class="text-blue">Marketing for how you show up.</span></h2></div>
      <p>We work with businesses that need better digital tools, stronger brand communication or both.</p>
    </div>
    <div class="home-service-grid">
      {services.map((service) => <article class="home-service-card">
        <div class:list={["service-card-art", service.visual]}>
          <span class="service-art-index">{service.number} / ZSKYLO</span>
          {service.id === "software" ? <div class="service-art-message software-message" aria-hidden="true"><span>01 / SOFTWARE</span><strong>Systems<br/>that <i>connect.</i></strong><small>WEBSITES · PLATFORMS · AUTOMATION</small></div> : <div class="service-art-message growth-message" aria-hidden="true"><span>02 / BRAND GROWTH</span><strong>Stories<br/>that <i>move.</i></strong><small>STRATEGY · CONTENT · CAMPAIGNS</small></div>}
          <span class="service-art-caption">{service.id === "software" ? "CONNECTED BY DESIGN" : "BUILT TO COMMUNICATE"}</span>
        </div>
        <div class="service-card-content">
          <div class="service-card-kicker"><span>{service.number}</span><span>{service.title}</span></div>
          <h3>{service.statement}</h3>
          <p>{service.description}</p>
          <ul>{service.capabilities.map((capability) => <li>{capability}</li>)}</ul>
          <a class="text-link" href={service.href}>{service.link} <span aria-hidden="true">→</span></a>
        </div>
      </article>)}
    </div>
  </section>

  <section class="tagline-section" aria-label="Our working principle">
    <div class="wrap tagline-inner">
      <p class="eyebrow eyebrow-light">How we approach the work</p>
      <p class="tagline-reveal" data-tagline-reveal>
        <span class="tagline-line"><span class="tagline-word">Clear</span> <span class="tagline-word">Scope.</span></span>
        <span class="tagline-line"><span class="tagline-word">Careful</span> <span class="tagline-word">Engineering.</span></span>
        <span class="tagline-line"><span class="tagline-word">Useful</span> <span class="tagline-word">Handover.</span></span>
      </p>
      <p class="tagline-support">Understand the requirements. Build with care. Hand over work your team can use.</p>
    </div>
  </section>

  <section class="process-section section">
    <div class="wrap">
      <div class="home-section-heading">
        <div><p class="eyebrow">A clear way forward</p><h2>How a project<br/>gets started.</h2></div>
        <p>Tell us what you need. We’ll review the requirements and discuss the scope before agreeing on the next steps.</p>
      </div>
      <div class="process-grid">
        <article><span class="process-number">01</span><h3>Send your requirements</h3><p>Tell us what you need, who it is for and what you want the work to achieve.</p></article>
        <article><span class="process-number">02</span><h3>Discuss the scope</h3><p>We review the brief, clarify what is involved and talk through a suitable approach.</p></article>
        <article><span class="process-number">03</span><h3>Agree on next steps</h3><p>When the requirements and scope are clear, we agree on how to proceed.</p></article>
      </div>
    </div>
  </section>

  <section class="home-work-section section">
    <div class="wrap">
      <div class="home-section-heading">
        <div><p class="eyebrow">Selected software work</p><h2>Websites and platforms<br/><span class="text-blue">we’ve delivered.</span></h2></div>
        <div class="work-heading-side"><p>A selection of client projects across e-commerce, education and consultancy.</p><a class="text-link" href="/work/">View all projects <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="live-work-grid">
        {projects.map((project) => <article class="live-work-card">
          <a class="live-preview" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.name} live website`}>
            <div class="live-preview-chrome"><span></span><span></span><span></span><small>{project.name}</small><b aria-hidden="true">↗</b></div>
            {project.name === "Skinociti" ? <img class="skinociti-home-static-preview" src="https://image.thum.io/get/width/1200/crop/800/noanimate/https://www.skinociti.com/" alt="Static screenshot preview of the Skinociti website" loading="lazy" /> : <iframe src={project.url} title={`${project.name} live website preview`} loading="lazy" tabindex="-1" referrerpolicy="strict-origin-when-cross-origin"></iframe>}
            <span class="preview-overlay">Open live website <b aria-hidden="true">↗</b></span>
          </a>
          <div class="live-work-meta"><span>{project.number} / {project.type}</span><a href={project.url} target="_blank" rel="noopener noreferrer">{project.name} <span aria-hidden="true">↗</span></a><p>{project.detail}</p></div>
        </article>)}
      </div>
      <p class="preview-disclaimer">Live website previews are embedded where the client website permits it. Some sites may restrict embedding; use the project link to open the live website.</p>
    </div>
  </section>

  <section class="products-section section">
    <div class="wrap">
      <div class="products-heading">
        <div><p class="eyebrow eyebrow-light">Beyond client projects</p><h2>Our products,<br/><span>built independently.</span></h2></div>
        <p>Alongside client work, we build standalone products. Each has its own team and website.</p>
      </div>
      <div class="independent-products">
        {products.map((product) => <article class="independent-product">
          
          <div><h3>{product.name}</h3><p>{product.description}</p></div>
          {product.url ? <a href={product.url} target="_blank" rel="noopener noreferrer">{product.label} <span aria-hidden="true">↗</span></a> : <span class="product-coming">{product.label}</span>}
        </article>)}
      </div>
      <div class="products-foot"><span>INDEPENDENT PRODUCT VENTURES</span><a href="/products/">Explore our products <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="faq-section section wrap">
    <div class="home-section-heading">
      <div><p class="eyebrow">A few useful answers</p><h2>Before you<br/><span class="text-blue">get started.</span></h2></div>
      <p>If your question is not covered here, send us a note and we’ll discuss it.</p>
    </div>
    <div class="faq-list">
      {faqs.map((faq, index) => <details class="faq-item">
        <summary><span class="faq-index">{String(index + 1).padStart(2, "0")}</span><span>{faq.q}</span><span class="faq-toggle" aria-hidden="true"><span class="faq-toggle-mark">+</span></span></summary>
        <div class="faq-answer"><p>{faq.a}</p></div>
      </details>)}
    </div>
  </section>

  <section class="final-cta">
    <div class="wrap final-cta-inner">
      <p class="eyebrow eyebrow-light">Have something in mind?</p>
      <h2>Have a project<br/><span>in mind?</span></h2>
      <p>Send us your requirements. We’ll review the brief and talk through the scope with you.</p>
      <a class="button button-light" href="/contact/">Start a Project <span aria-hidden="true">↗</span></a>
      <span class="final-cta-note">NO INITIAL CONSULTATION FEE</span>
    </div>
  </section>

  <script>
    const heading = document.querySelector<HTMLElement>(".hero-typewriter");
    const typewriterLines = heading?.querySelectorAll<HTMLSpanElement>("[data-typewriter-line]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (heading && typewriterLines?.length) {
      const lines = Array.from(typewriterLines);
      const fullTexts = lines.map((line) => line.dataset.typewriterLine || "");

      if (reduceMotion) {
        lines.forEach((line, index) => {
          line.textContent = fullTexts[index];
          line.classList.add("is-complete");
        });
        heading.classList.remove("is-pending");
        heading.classList.add("is-typed");
      } else {
        // Clear the server-rendered text before revealing the heading, preventing a full-text flash.
        lines.forEach((line) => {
          line.textContent = "";
        });
        heading.classList.remove("is-pending");

        const typeLine = (lineIndex: number, characterIndex = 0) => {
          const line = lines[lineIndex];
          const fullText = fullTexts[lineIndex];

          if (!line || fullText === undefined) {
            heading.classList.add("is-typed");
            return;
          }

          line.classList.add("is-active");
          line.textContent = fullText.slice(0, characterIndex);

          if (characterIndex < fullText.length) {
            window.setTimeout(() => typeLine(lineIndex, characterIndex + 1), 42);
            return;
          }

          line.classList.remove("is-active");
          line.classList.add("is-complete");

          if (lineIndex + 1 < lines.length) {
            window.setTimeout(() => typeLine(lineIndex + 1), 180);
          } else {
            heading.classList.add("is-typed");
          }
        };

        typeLine(0);
      }
    }
  </script>
</SiteLayout>
