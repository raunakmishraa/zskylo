---
import SiteLayout from "../layouts/SiteLayout.astro";
const products = [
  { n: "01", name: "AashrayaCare", category: "Care discovery platform", description: "A platform for families to discover caregivers and care homes.", url: "https://aashraya-care.netlify.app/", action: "Explore AashrayaCare", status: "Live", preview: true, monogram: "AC" },
  { n: "02", name: "Yittzy", category: "Town events", description: "An event-listing platform designed to help people discover what’s happening in their town.", url: "", action: "", status: "Coming soon", preview: false, monogram: "YT" },
  { n: "03", name: "Cashify Wallet", category: "Fintech product", description: "A digital presence for the Cashify Wallet product.", url: "https://cashifywallet.com/", action: "Visit website", status: "Live", preview: true, monogram: "CW" },
];
---
<SiteLayout title="Our Products — Zskylo" description="Independent digital products developed by Zskylo, each with its own team and website.">
  <section class="page-hero wrap">
    <p class="eyebrow"><span class="eyebrow-line"></span> Our products / 03</p>
    <h1>Ideas shaped<br />into <span class="text-blue">useful tools.</span></h1>
    <p class="page-lede">Independent product ventures, each developed around a focused purpose with its own team and digital presence.</p>
  </section>
  <section class="wrap product-showcase-grid" aria-label="Independent Zskylo products">
    {products.map((product) => <article class="product-showcase-card" aria-labelledby={`product-title-${product.n}`}>
      {product.preview ? <a class="site-glimpse product-glimpse" href={product.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${product.name} live website`}>
        <span class="glimpse-browser-bar"><span class="glimpse-browser-dots"><i></i><i></i><i></i></span><span>{product.name}</span><span class="glimpse-preview-type">Live website</span><b aria-hidden="true">↗</b></span>
        <iframe src={product.url} title={`${product.name} live website preview`} loading="lazy" tabindex="-1" referrerpolicy="strict-origin-when-cross-origin"></iframe>
        <span class="glimpse-open-label">Explore live website <b aria-hidden="true">↗</b></span>
      </a> : <div class="product-coming-visual" aria-label="Yittzy product preview coming soon">
        <span class="glimpse-browser-bar"><span class="glimpse-browser-dots"><i></i><i></i><i></i></span><span>Yittzy / Preview</span><span class="glimpse-preview-type">In development</span><b>—</b></span>
        <div class="yittzy-preview-art"><span class="yittzy-mark">Y</span><span class="yittzy-overline">YOUR TOWN, IN THE KNOW</span><strong>Find your<br/><i>next thing.</i></strong><span class="yittzy-preview-status">PRODUCT PREVIEW COMING SOON</span></div>
      </div>}
      <div class="product-showcase-info">
        <div class="product-showcase-heading"><span class="project-number">{product.n}</span><span class="eyebrow">{product.category}</span></div>
        <h2 id={`product-title-${product.n}`}>{product.name}</h2>
        <p>{product.description}</p>
        {product.url ? <a class="text-link" href={product.url} target="_blank" rel="noopener noreferrer">{product.action} <span aria-hidden="true">↗</span></a> : <span class="coming-label"><span class="status-dot"></span>{product.status}</span>}
      </div>
    </article>)}
  </section>
  <p class="wrap product-preview-note">Live previews are loaded from each product website. If an embedded preview is restricted by the site, use its direct link to open it separately. Yittzy is shown as a coming-soon concept preview.</p>\n  <section class="section wrap service-end"><p class="eyebrow">Independent ventures</p><h2>Different teams.<br/><span class="text-blue">Distinct ambitions.</span></h2><p class="page-lede">Our products are developed separately from client service engagements, with their own focus and websites.</p></section>
</SiteLayout>
