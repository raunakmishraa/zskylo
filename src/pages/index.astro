---
import SiteLayout from "../layouts/SiteLayout.astro";
const divisions = [
  { number: "01", title: "Software Development", tag: "Design & build", text: "We create websites, e-commerce platforms, CRM systems and custom digital tools. From a business website to an online store or a purpose-built workflow, the work starts with what needs to get done.", includes: ["Websites", "E-commerce", "CRM systems", "Digital tools"], href: "/services/#software", link: "Explore software services" },
  { number: "02", title: "Brand Growth", tag: "Create & communicate", text: "We help brands show up with clear, considered content. Our work can span social and digital marketing, ad scripting, shooting, video editing and bringing the finished content together for delivery.", includes: ["Video editing", "Social media marketing", "Digital marketing", "Ad scripting & shooting"], href: "/services/#growth", link: "Explore brand growth" },
  { number: "03", title: "Our Products", tag: "Build our own ideas", text: "Alongside client work, we develop digital products around specific needs — from discovering care services to finding local events and exploring digital wallet services.", includes: ["AashrayaCare", "Yittzy · coming soon", "Cashify Wallet"], href: "/products/", link: "Discover our products" },
];
---
<SiteLayout title="Zskylo — Clear thinking. Useful digital work." description="Zskylo brings together software development, brand growth and digital products.">
  <section class="hero wrap">
    <div class="hero-copy">
      <p class="eyebrow"><span class="eyebrow-line"></span> Digital studio · Nepal</p>
      <h1>Make digital<br /><span class="text-blue">work better.</span></h1>
      <p class="hero-intro">We build websites and digital tools, help brands create and deliver content, and develop products of our own — three connected parts of Zskylo.</p>
      <div class="hero-actions">
        <a class="button" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="/work/">Explore our work <span aria-hidden="true">→</span></a>
      </div>
    </div>
    <div class="hero-visual" aria-label="Abstract modular network illustration" role="img">
      <div class="visual-top"><span>ZS / 001</span><span>Connected by design</span></div>
      <div class="network">
        <span class="node node-a"></span><span class="node node-b"></span><span class="node node-c"></span><span class="node node-d"></span>
        <span class="network-line line-a"></span><span class="network-line line-b"></span><span class="network-line line-c"></span><span class="network-line line-d"></span>
        <span class="network-core">Z</span>
      </div>
      <div class="visual-bottom"><span>THOUGHTFUL DIGITAL WORK</span><span>IMADOL · NEPAL</span></div>
    </div>
    <div class="hero-index"><span>01</span><span class="index-rule"></span><span>03</span></div>
  </section>

  <section class="intro-band">
    <div class="wrap intro-grid">
      <p class="eyebrow">A considered approach</p>
      <p class="intro-statement">Different disciplines. One aim: make digital work <span class="text-blue">clearer, more useful,</span> and easier to move forward with.</p>
    </div>
  </section>

  <section class="section wrap divisions-section">
    <div class="section-heading">
      <div><p class="eyebrow">The three divisions</p><h2>One studio.<br />Three areas of work.</h2></div>
      <p class="section-aside">Each division has a distinct role — building for clients, growing brand communication, and creating products of our own.</p>
    </div>
    <div class="division-cards">
      {divisions.map((item) => <article class="division-card">
        <div class="division-card-top"><span class="division-number">{item.number}</span><span class="division-tag">{item.tag}</span></div>
        <h3>{item.title}</h3>
        <p>{item.text}</p>
        <div class="division-includes"><span class="eyebrow">What this includes</span><ul>{item.includes.map((entry) => <li>{entry}</li>)}</ul></div>
        <a class="text-link" href={item.href}>{item.link} <span aria-hidden="true">→</span></a>
      </article>)}
    </div>
  </section>

  <section class="work-preview">
    <div class="wrap preview-inner">
      <div><p class="eyebrow eyebrow-light">Selected software projects</p><h2>See the work<br />in its own context.</h2></div>
      <div><p class="preview-copy">Explore websites and e-commerce projects developed across commerce, education and consultancy.</p><a class="button button-light" href="/work/">View software work <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="wrap preview-foot"><span>SOFTWARE DEVELOPMENT</span><span>SELECTED PROJECTS / 06</span></div>
  </section>

  <section class="section wrap closing-section">
    <p class="eyebrow">Have something in mind?</p>
    <div class="closing-row"><h2>Let’s make it<br /><span class="text-blue">work for you.</span></h2><a class="button" href="/contact/">Talk to Zskylo <span aria-hidden="true">↗</span></a></div>
  </section>
</SiteLayout>
