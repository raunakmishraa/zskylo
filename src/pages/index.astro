---
import SiteLayout from "../layouts/SiteLayout.astro";

const services = [
  {
    number: "01",
    id: "software",
    title: "Software Development",
    statement: "Build the systems your business needs.",
    description: "We connect applications, automate workflows and develop custom websites, platforms and business systems around the way your organisation works.",
    capabilities: ["Websites & web applications", "Custom business systems", "CRM & digital tools", "Workflow automation & integrations"],
    href: "/services/#software",
    link: "Explore software development",
    visual: "software-visual",
  },
  {
    number: "02",
    id: "growth",
    title: "Brand Growth",
    statement: "Give your brand a clearer voice.",
    description: "We bring strategy and creative execution together through content, video production and digital marketing that helps businesses communicate with purpose.",
    capabilities: ["Social & digital marketing", "Video editing & production", "Ad scripting & creative direction", "Shooting & content delivery"],
    href: "/services/#growth",
    link: "Explore brand growth",
    visual: "growth-visual",
  },
];

const projects = [
  { number: "01", name: "Skinociti", type: "Electronics e-commerce", detail: "E-commerce website for a US electronics business.", url: "https://www.skinociti.com/" },
  { number: "02", name: "Rapti Fashion Direct", type: "E-commerce · Laravel", detail: "E-commerce platform developed for a US client.", url: "https://raptifashiondirect.com/" },
  { number: "03", name: "Study Overseas", type: "Education consultancy", detail: "Website for an education consultancy in Nepal.", url: "https://www.studyoverseas.edu.np/" },
  { number: "04", name: "Investment Guru 2.0", type: "Education & enrolment", detail: "Website for a share-market training institute, including course enrolment.", url: "https://www.investmentguru.com.np/" },
  { number: "05", name: "Investment Guru v1", type: "Previous website version", detail: "An earlier version of the Investment Guru website.", url: "https://ig-v1.raunakmishra.com.np/" },
  { number: "06", name: "Nexo Global", type: "International consultancy", detail: "Consultancy website for an Australian client.", url: "https://nexoglobal.netlify.app/" },
];

const products = [
  { name: "AashrayaCare", description: "Caregiver and care-home discovery platform.", url: "https://aashraya-care.netlify.app/", label: "Explore product", code: "AC" },
  { name: "Yittzy", description: "A town event-listing platform.", url: "", label: "Coming soon", code: "YT" },
  { name: "Cashify Wallet", description: "An independent fintech product.", url: "https://cashifywallet.com/", label: "Explore product", code: "CW" },
];

const faqs = [
  { q: "What does Zskylo do?", a: "Zskylo works with businesses across two service areas: Software Development and Brand Growth. We also develop independent digital products through separate product teams." },
  { q: "What kind of software projects do you take on?", a: "Our software work includes websites, e-commerce platforms, web applications, CRM systems, workflow automation, integrations and custom business tools. The right scope depends on your requirements." },
  { q: "What is included in Brand Growth?", a: "Depending on the brief, Brand Growth can include brand and content strategy, social media marketing, digital marketing, ad scripting, shooting, video editing and complete content delivery." },
  { q: "How do I start a project?", a: "Share your requirements through our project enquiry form. Tell us what you are trying to achieve, and we will review the information and discuss the possible scope and next steps." },
  { q: "Is there a fee for the initial discussion?", a: "There is no initial consultation fee. You can share your project requirements first, and we can discuss the approach and next steps." },
  { q: "How much does a project cost?", a: "Costs depend on the work involved, its complexity and the agreed scope. We discuss pricing after understanding your requirements." },
  { q: "How long will a project take?", a: "Timelines vary by project. We discuss a realistic schedule after reviewing the requirements and defining the scope." },
  { q: "Are AashrayaCare, Yittzy and Cashify Wallet client services?", a: "No. They are independent product ventures developed separately from client service projects, with their own teams and websites." },
];
---
<SiteLayout title="Zskylo | Software Development & Brand Growth in Nepal" description="Zskylo helps businesses build custom software, connect applications, automate workflows and grow their brands through creative and digital marketing solutions.">
  <section class="home-hero">
    <div class="wrap home-hero-grid">
      <div class="home-hero-copy">
        <p class="eyebrow"><span class="eyebrow-line"></span> Software Development · Brand Growth · Nepal</p>
        <h1>Build better systems.<br /><span class="text-blue">Grow stronger brands.</span></h1>
        <p class="home-hero-lede">We connect applications, automate workflows, build custom business systems and shape brand growth strategies for businesses ready to move forward.</p>
        <a class="button home-primary-cta" href="/contact/">Start a Project <span aria-hidden="true">↗</span></a>
        <p class="hero-note">Share your requirements. We’ll discuss the right next step.</p>
      </div>
      <div class="home-hero-art" role="img" aria-label="Abstract diagram showing connected business systems and creative channels">
        <div class="art-topline"><span>ZS / SYSTEMS + STORY</span><span>NEPAL · WORKING EVERYWHERE</span></div>
        <div class="art-grid-lines" aria-hidden="true"></div>
        <div class="art-center"><span class="art-center-mark">Z</span><span>BUSINESS<br/>IN MOTION</span></div>
        <div class="art-node art-node-one"><span class="art-node-symbol">↗</span><b>CONNECT</b><small>Applications</small></div>
        <div class="art-node art-node-two"><span class="art-node-symbol">⌘</span><b>BUILD</b><small>Systems</small></div>
        <div class="art-node art-node-three"><span class="art-node-symbol">✳</span><b>GROW</b><small>Brands</small></div>
        <span class="art-orbit art-orbit-one" aria-hidden="true"></span>
        <span class="art-orbit art-orbit-two" aria-hidden="true"></span>
        <div class="art-bottomline"><span>01 — CLARITY</span><span>02 — EXECUTION</span><span>03 — HANDOVER</span></div>
      </div>
    </div>
    <div class="wrap hero-footnote"><span>IMADOL, LALITPUR, NEPAL</span><span>TECHNOLOGY × CREATIVE EXECUTION</span></div>
  </section>

  <section class="home-services section wrap" id="services">
    <div class="home-section-heading">
      <div><p class="eyebrow">What we do</p><h2>Two ways to move<br/><span class="text-blue">your business forward.</span></h2></div>
      <p>Whether you need a better digital foundation or a stronger brand presence, start with the challenge you want to solve.</p>
    </div>
    <div class="home-service-grid">
      {services.map((service) => <article class="home-service-card">
        <div class:list={["service-card-art", service.visual]}>
          <span class="service-art-index">{service.number} / ZSKYLO</span>
          {service.id === "software" ? <div class="system-art" aria-hidden="true"><span class="system-window system-window-a"><i></i><i></i><i></i><b>CRM / OVERVIEW</b><em></em><em></em></span><span class="system-window system-window-b"><i></i><i></i><i></i><b>WORKFLOW</b><em></em><em></em></span><span class="system-connector"></span><span class="system-dot"></span></div> : <div class="brand-art" aria-hidden="true"><span class="brand-art-word">MAKE<br/>IT <i>MATTER.</i></span><span class="brand-art-orbit"></span><span class="brand-art-tag">STRATEGY / CONTENT / REACH</span></div>}
          <span class="service-art-caption">{service.id === "software" ? "CONNECTED BY DESIGN" : "BUILT TO COMMUNICATE"}</span>
        </div>
        <div class="service-card-content">
          <div class="service-card-kicker"><span>{service.number}</span><span>{service.title}</span></div>
          <h3>{service.statement}</h3>
          <p>{service.description}</p>
          <ul>{service.capabilities.map((capability) => <li>{capability}</li>)}</ul>
          <a class="text-link" href={service.href}>{service.link} <span aria-hidden="true">→</span></a>
        </div>
      </article>)}
    </div>
  </section>

  <section class="tagline-section" aria-label="Our working principle">
    <div class="wrap tagline-inner">
      <p class="eyebrow eyebrow-light">How we approach the work</p>
      <p class="tagline-reveal" data-tagline-reveal>
        <span class="tagline-line"><span class="tagline-word">Clear</span> <span class="tagline-word">Scope.</span></span>
        <span class="tagline-line"><span class="tagline-word">Careful</span> <span class="tagline-word">Engineering.</span></span>
        <span class="tagline-line"><span class="tagline-word">Useful</span> <span class="tagline-word">Handover.</span></span>
      </p>
      <p class="tagline-support">A practical principle for every engagement: understand the need, do the work with care, and leave you with something useful.</p>
    </div>
  </section>

  <section class="process-section section">
    <div class="wrap">
      <div class="home-section-heading">
        <div><p class="eyebrow">A clear way forward</p><h2>From requirements<br/>to a considered plan.</h2></div>
        <p>Good work starts with understanding what needs to change. We keep the first steps straightforward.</p>
      </div>
      <div class="process-grid">
        <article><span class="process-number">01</span><h3>Share the requirements</h3><p>Tell us about your business, what you need and the outcome you are working towards.</p></article>
        <article><span class="process-number">02</span><h3>Define the approach</h3><p>We review the brief, clarify the scope and discuss a suitable direction.</p></article>
        <article><span class="process-number">03</span><h3>Move forward</h3><p>Once the scope is understood, we agree on the next steps for the project.</p></article>
      </div>
    </div>
  </section>

  <section class="home-work-section section">
    <div class="wrap">
      <div class="home-section-heading">
        <div><p class="eyebrow">Selected software work</p><h2>Built for different<br/><span class="text-blue">business needs.</span></h2></div>
        <div class="work-heading-side"><p>Explore a selection of websites and platforms developed across commerce, education and consultancy.</p><a class="text-link" href="/work/">View all projects <span aria-hidden="true">→</span></a></div>
      </div>
      <div class="live-work-grid">
        {projects.map((project) => <article class="live-work-card">
          <a class="live-preview" href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${project.name} live website`}>
            <div class="live-preview-chrome"><span></span><span></span><span></span><small>{project.name}</small><b aria-hidden="true">↗</b></div>
            <iframe src={project.url} title={`${project.name} live website preview`} loading="lazy" tabindex="-1" referrerpolicy="strict-origin-when-cross-origin"></iframe>
            <span class="preview-overlay">Open live website <b aria-hidden="true">↗</b></span>
          </a>
          <div class="live-work-meta"><span>{project.number} / {project.type}</span><a href={project.url} target="_blank" rel="noopener noreferrer">{project.name} <span aria-hidden="true">↗</span></a><p>{project.detail}</p></div>
        </article>)}
      </div>
      <p class="preview-disclaimer">Live website previews are embedded where the client website permits it. Some sites may restrict embedding; use the project link to open the live website.</p>
    </div>
  </section>

  <section class="products-section section">
    <div class="wrap">
      <div class="products-heading">
        <div><p class="eyebrow eyebrow-light">Beyond client projects</p><h2>Independent ideas.<br/><span>Distinct purposes.</span></h2></div>
        <p>Zskylo also develops its own products. Each venture is handled separately, with its own team and website, independent from our client service work.</p>
      </div>
      <div class="independent-products">
        {products.map((product) => <article class="independent-product">
          <span class="product-monogram" aria-hidden="true">{product.code}</span>
          <div><h3>{product.name}</h3><p>{product.description}</p></div>
          {product.url ? <a href={product.url} target="_blank" rel="noopener noreferrer">{product.label} <span aria-hidden="true">↗</span></a> : <span class="product-coming">{product.label}</span>}
        </article>)}
      </div>
      <div class="products-foot"><span>INDEPENDENT PRODUCT VENTURES</span><a href="/products/">Explore our products <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="faq-section section wrap">
    <div class="home-section-heading">
      <div><p class="eyebrow">A few useful answers</p><h2>Before you<br/><span class="text-blue">get started.</span></h2></div>
      <p>Have a question that is not covered here? Share your requirements and we can discuss it directly.</p>
    </div>
    <div class="faq-list">
      {faqs.map((faq, index) => <details class="faq-item">
        <summary><span class="faq-index">{String(index + 1).padStart(2, "0")}</span><span>{faq.q}</span><span class="faq-toggle" aria-hidden="true">+</span></summary>
        <div class="faq-answer"><p>{faq.a}</p></div>
      </details>)}
    </div>
  </section>

  <section class="final-cta">
    <div class="wrap final-cta-inner">
      <p class="eyebrow eyebrow-light">Have something in mind?</p>
      <h2>Tell us what you’re<br/><span>looking to build or grow.</span></h2>
      <p>Share your project requirements. We’ll review them and discuss a practical next step.</p>
      <a class="button button-light" href="/contact/">Start a Project <span aria-hidden="true">↗</span></a>
      <span class="final-cta-note">NO INITIAL CONSULTATION FEE</span>
    </div>
  </section>

  <script>
    const reveal = document.querySelector("[data-tagline-reveal]");
    const words = reveal?.querySelectorAll(".tagline-word");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (words?.length) {
      if (reduceMotion || !("IntersectionObserver" in window)) {
        words.forEach((word) => word.classList.add("is-active"));
      } else {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-active");
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: "-43% 0px -43% 0px", threshold: 0 });
        words.forEach((word) => observer.observe(word));
      }
    }
  </script>
</SiteLayout>
