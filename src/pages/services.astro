---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Services — Zskylo" description="Software development and brand growth services from Zskylo.">
  <section class="page-hero wrap">
    <p class="eyebrow"><span class="eyebrow-line"></span> Capabilities / 01</p>
    <h1>Good work starts<br />with <span class="text-blue">the right focus.</span></h1>
    <p class="page-lede">We bring together technical execution and creative thinking to help businesses move forward.</p>
  </section>
  <section id="software" class="service-block wrap">
    <div class="service-meta"><span>01 / SOFTWARE DEVELOPMENT</span><span>Plan · Design · Build</span></div>
    <div class="service-content"><h2>Digital foundations<br />that do their job.</h2><div><p>We develop websites, e-commerce experiences, CRM systems and digital tools that help businesses serve people and operate more effectively.</p><ul class="capability-list"><li>Website design & development</li><li>E-commerce platforms</li><li>CRM and business tools</li><li>Custom digital solutions</li></ul><a class="text-link" href="/work/">Explore selected projects <span aria-hidden="true">→</span></a></div></div>
  </section>
  <section id="growth" class="service-block service-muted">
    <div class="wrap">
      <div class="service-meta"><span>02 / BRAND GROWTH</span><span>Creative · Campaigns · Delivery</span></div>
      <div class="service-content"><h2>Make your message<br />worth noticing.</h2><div><p>Creative and marketing support spanning video editing, social media marketing, digital marketing, ad scripting, shooting and complete content delivery.</p><div class="coming-panel"><span class="status-dot"></span><div><strong>Portfolio coming soon</strong><p>We’re preparing this section. Selected work will appear here once it is ready to share.</p></div></div></div></div>
    </div>
  </section>
  <section class="section wrap service-end"><p class="eyebrow">Not sure where to begin?</p><h2>Tell us what you’re<br /><span class="text-blue">trying to achieve.</span></h2><a class="button" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a></section>
</SiteLayout>
